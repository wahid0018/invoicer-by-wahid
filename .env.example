# Public client configuration. The Supabase anon/publishable key is intended for
# browser use; database access must be protected by the committed RLS migration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy anon keys are also accepted when SUPABASE_PUBLISHABLE_KEY is unset.
# SUPABASE_ANON_KEY=your-project-anon-key
